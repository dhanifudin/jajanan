SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Prefixed to avoid colliding with lulu's VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY
# in the shared project's Edge Function secrets (supabase secrets set is
# project-wide, not per-function).
JAJANAN_VAPID_PUBLIC_KEY=your-vapid-public-key-here
JAJANAN_VAPID_PRIVATE_KEY=your-vapid-private-key-here
